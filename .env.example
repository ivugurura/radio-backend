# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=

# Database (PostgreSQL)
DB_NAME=dj_graphql
DB_USER=dj_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Media storage
RADIO_ROOT=/srv/radio

# Audio transcoding
DEFAULT_TARGET_BR_KBPS=128
DEFAULT_TARGET_SR_HZ=48000
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Studio ingest auth
STUDIO_TOKEN=
STUDIO_INTERNAL_URL=

# Streaming credentials (BUTT / Icecast-style encoders)
STREAMING_CREDENTIAL_KEY=
STREAMING_INGEST_HOST=localhost
STREAMING_INGEST_PORT=
