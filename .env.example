# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=

# Database (PostgreSQL)
DB_NAME=dj_graphql
DB_USER=dj_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CACHE_REDIS_URL=
UPLOAD_STALE_AFTER_HOURS=6

# Media storage
RADIO_ROOT=/srv/radio

# Audio transcoding
DEFAULT_TARGET_BR_KBPS=
DEFAULT_TARGET_SR_HZ=
FFMPEG_PATH=
FFPROBE_PATH=

# Studio ingest auth
STUDIO_TOKEN=
STUDIO_INTERNAL_URL=

# Streaming credentials (BUTT / Icecast-style encoders)
STREAMING_CREDENTIAL_KEY=
STREAMING_INGEST_HOST=
STREAMING_INGEST_PORT=

# Dashboard capacity quotas (per studio). Leave unset to use the VPS-based
# estimate in apps/studio/schema/queries/dashboard.py.
LISTENING_SECONDS_QUOTA=
DISK_QUOTA_GB=

# Accounts: links in invite/reset emails point at the UI.
FRONTEND_URL=
INVITE_TOKEN_TTL_HOURS=168
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# SMTP for invite / password-reset emails. Leave EMAIL_HOST empty to send
# nothing (admins then copy links by hand and "Forgot password" is hidden).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=

# Frontend URL (used for email links, etc.)
FRONTEND_URL=
