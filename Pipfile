[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[scripts]
start = "python manage.py runserver"
start-celery = "celery -A config worker -l info"

[packages]
django = "==5.2.7"
graphene-django = "==3.2.3"
django-filter = "==25.1"
psycopg2-binary = "==2.9.10"
python-dotenv = "==1.1.1"
django-graphql-jwt = "==0.4.0"
argon2-cffi = "==25.1.0"
cryptography = "==50.0.0"
djangorestframework = "==3.16.1"
django-cors-headers = "==4.9.0"
celery = "==5.5.3"
django-redis = "==6.0.0"
gunicorn = "==26.0.0"
channels = "==4.3.1"
channels-redis = "==4.3.0"
# Pinned below channels-redis's own floor of 4.6 to avoid redis-py 5+, whose
# blocking-command timeout handling races with channels-redis 4.3.0's BZPOPMIN
# poll loop and raises spurious redis.exceptions.TimeoutError on idle sockets.
redis = "==4.6.0"
daphne = "==4.2.1"
uvicorn = {extras = ["standard"], version = "==0.35.0"}

[dev-packages]
black = "==25.9.0"
isort = "==7.0.0"
mypy = "==1.18.2"
pytest = "==8.4.2"
pytest-django = "==4.11.1"

[requires]
python_version = "3.12"
python_full_version = "3.12.8"
